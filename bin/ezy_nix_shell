#!/usr/bin/env bash

# Resolve flake location
function get_flake_ref() {
  local SCRIPT_DIR
  SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." 2>/dev/null && pwd)"

  if [ -n "${EZY_TOOLS_DIR}" ] && [ -f "${EZY_TOOLS_DIR}/flake.nix" ]; then
    echo "${EZY_TOOLS_DIR}"
  elif [ -f "${SCRIPT_DIR}/flake.nix" ] && [ "${SCRIPT_DIR}" != "${HOME}/.local" ]; then
    echo "${SCRIPT_DIR}"
  elif [ -f "${HOME}/.config/nix/shells/ezy-tools/flake.nix" ]; then
    echo "${HOME}/.config/nix/shells/ezy-tools"
  elif [ -f "${HOME}/Documents/ezy-tools/flake.nix" ]; then
    echo "${HOME}/Documents/ezy-tools"
  elif [ -f "${HOME}/.config/nix/shells/flake.nix" ]; then
    echo "${HOME}/.config/nix/shells"
  else
    echo "github:Ezyrath/ezy-tools"
  fi
}

FLAKE_REF="$(get_flake_ref)"
COMMAND="$1"
SHELL_NAME="$2"

function list() {
  echo "Available Nix development environments in ${FLAKE_REF}:"
  echo "  - dev        (Full development FHS environment: Rust, C++, Java, Node, Sway, etc.) [default]"
  echo "  - unreal     (Unreal Engine FHS build & runtime environment with CUDA)"
  echo "  - godot      (Godot engine build environment)"
  echo "  - jetbrains  (JetBrains IDEs & SDKs environment)"
  echo "  - empty      (Clean minimal shell environment)"
}

function run() {
  local TARGET="${SHELL_NAME:-dev}"
  shift 2 2>/dev/null || shift 1 2>/dev/null
  nix develop --extra-experimental-features "nix-command flakes" "${FLAKE_REF}#${TARGET}" "$@"
}

function install() {
  local TARGET="${SHELL_NAME:-dev}"
  cat << SHELL_EOF > ./shell.nix
# Generated by ezy_nix_shell
(builtins.getFlake "${FLAKE_REF}").devShells.\${builtins.currentSystem}.${TARGET}
SHELL_EOF
  echo "Created shell.nix pointing to ${FLAKE_REF}#${TARGET}"
}

case "$COMMAND" in
run)
  run "$@"
  ;;
install)
  install
  ;;
list)
  list
  ;;
*)
  printf "%s\n" \
    "
Usage: ezy_nix_shell <command> [arguments]

Commands:
  run      [NAME] [OPTIONS]  -- enter a specific dev shell (e.g. dev, unreal, godot)
  install  [NAME]            -- generate a shell.nix in the current directory
  list                       -- list all available environments
    "
  ;;
esac
